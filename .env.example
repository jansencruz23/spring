# Copy to `.env` and fill in. `EXPO_PUBLIC_*` vars are bundled into the client.
# Server-only secrets go into Supabase Edge Function secrets (see M0-WIRING.md).

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Edge Function only — NOT prefixed EXPO_PUBLIC_ so it never leaks to the client.
# Set via `supabase secrets set NIM_API_KEY=...` after `supabase link`.
# NIM_API_KEY=
